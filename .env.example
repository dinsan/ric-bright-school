# Lumina API settings. Copy to `.env` and adjust:  cp .env.example .env
#
# Every variable is optional; the values below are the defaults for local development.
# Real environment variables take precedence over this file. `.env` is git-ignored and is
# never copied into the Docker image. Docker Compose also reads it (for LUMINA_SECRET_KEY and
# LUMINA_FRONTEND_URL).

# local | test | staging | production
# Anything other than `local` switches logs to JSON; `production` also hides /docs.
LUMINA_ENVIRONMENT=local
LUMINA_LOG_LEVEL=INFO

# asyncpg URL. Matches the `db` service from `make db` / docker-compose.yml.
# (Inside Docker Compose the API uses host `db` instead of `localhost`; Compose sets that.)
LUMINA_DATABASE_URL=postgresql+asyncpg://lumina:lumina@localhost:5432/lumina

# --- CORS ---------------------------------------------------------------------------------
# Browser origins allowed to call the API (for example the web frontend).
#
# Format: a JSON array of strings. Wrap the whole value in single quotes so the double
# quotes inside survive. Each origin is scheme + host + optional port: no path and no
# trailing slash.
#
#   Valid:    LUMINA_CORS_ORIGINS='["http://localhost:3000"]'
#   Invalid:  LUMINA_CORS_ORIGINS=http://localhost:3000          (not JSON: startup fails)
#   Invalid:  LUMINA_CORS_ORIGINS="['http://localhost:3000']"    (JSON needs double quotes)
#
# With LUMINA_ENVIRONMENT=production, startup also fails if the list is empty ('[]') or
# contains "*". Production must list its real origins.
#
# Example 1: local frontend only (the default)
LUMINA_CORS_ORIGINS='["http://localhost:3000"]'
#
# Example 2: several origins, e.g. a deployed web app plus its staging site
# LUMINA_CORS_ORIGINS='["https://app.lumina.example","https://staging.lumina.example"]'

# --- Authentication -----------------------------------------------------------------------
# Signs the access tokens. At least 32 characters, random, and secret: anyone who knows it
# can mint tokens for any account. The API refuses to start in production with the
# built-in development key. `make bootstrap` fills in a random one. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LUMINA_SECRET_KEY=

# Encrypts two-factor (TOTP) secrets stored in the database. Set it to its own random value
# (like LUMINA_SECRET_KEY) and never change it: with another key, existing 2FA set-ups stop
# working. Empty: derived from LUMINA_SECRET_KEY (then never rotate that one).
LUMINA_ENCRYPTION_KEY=

# Token lifetimes. Access tokens are short-lived; refresh tokens rotate on every use.
# Sessions are shorter for children (see docs/auth.md): Grades 1-3 get one school day.
# LUMINA_ACCESS_TOKEN_TTL_MINUTES=15
# LUMINA_REFRESH_TOKEN_TTL_DAYS=30
# LUMINA_IMPERSONATION_TTL_MINUTES=15

# --- Email ----------------------------------------------------------------------------------
# Links in emails (verify address, reset password, ...) point at the web app, which sends the
# token to the API.
LUMINA_FRONTEND_URL=http://localhost:3000
LUMINA_EMAIL_FROM=Lumina <no-reply@lumina.example>

# SMTP server. The defaults are Mailpit from docker-compose.yml (`make mail`): it catches
# every email, nothing is really sent, and you read them at http://localhost:8025.
LUMINA_SMTP_HOST=localhost
LUMINA_SMTP_PORT=1025
# For a real provider (Postmark, SES, Resend, ...), for example:
# LUMINA_SMTP_HOST=smtp.example.com
# LUMINA_SMTP_PORT=587
# LUMINA_SMTP_STARTTLS=true
# LUMINA_SMTP_USERNAME=apikey
# LUMINA_SMTP_PASSWORD=...

# --- Media storage (uploads) -------------------------------------------------------------
# S3-compatible storage. The defaults are MinIO from docker-compose.yml (`make storage`),
# console at http://localhost:9001 (user lumina). For AWS S3, Cloudflare R2, ... set the
# endpoint, region, bucket and keys of your provider (production refuses the MinIO
# default secret below).
LUMINA_STORAGE_ENDPOINT_URL=http://localhost:9000
# What browsers use, when it differs from the above (e.g. API inside Docker).
LUMINA_STORAGE_PUBLIC_ENDPOINT_URL=
LUMINA_STORAGE_BUCKET=lumina-media
LUMINA_STORAGE_REGION=us-east-1
LUMINA_STORAGE_ACCESS_KEY=lumina
LUMINA_STORAGE_SECRET_KEY=lumina-dev-storage-secret
# Optional CDN in front of the bucket (then links are CDN URLs instead of signed ones).
LUMINA_MEDIA_CDN_BASE_URL=
# Sites lessons may embed (https only). A JSON array, like LUMINA_CORS_ORIGINS.
# LUMINA_EMBED_ALLOWED_HOSTS='["www.youtube.com","www.geogebra.org","phet.colorado.edu"]'

# --- Sign in with Google / Microsoft / Apple (optional) -------------------------------------
# A provider is switched on by filling in its values. Each needs this redirect URI
# registered in the provider's console, exactly:
#   {LUMINA_API_PUBLIC_URL}/api/v1/auth/oauth/{google|microsoft|apple}/callback
LUMINA_API_PUBLIC_URL=http://localhost:8000

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
LUMINA_GOOGLE_CLIENT_ID=
LUMINA_GOOGLE_CLIENT_SECRET=

# Microsoft Entra > App registrations. Tenant: common (work, school and personal accounts),
# organizations, consumers, or your tenant id for one organisation only. To let work/school
# emails match existing accounts, add the optional claim "xms_edov" to the ID token.
LUMINA_MICROSOFT_CLIENT_ID=
LUMINA_MICROSOFT_CLIENT_SECRET=
LUMINA_MICROSOFT_TENANT=common

# Apple Developer > Certificates, Identifiers & Profiles: a Services ID, your Team ID, and a
# "Sign in with Apple" key (.p8). Put the key on one line with \n for the line breaks.
LUMINA_APPLE_CLIENT_ID=
LUMINA_APPLE_TEAM_ID=
LUMINA_APPLE_KEY_ID=
LUMINA_APPLE_PRIVATE_KEY=
